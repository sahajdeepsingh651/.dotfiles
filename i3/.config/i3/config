# i3 config - Ergonomic Vim-style setup
# Designed for: Caps→Ctrl, tmux prefix Ctrl+a, Alacritty

#==============================================================================
# CORE SETTINGS
#==============================================================================

# Super (Win) key as mod - avoids conflict with tmux Ctrl+a
set $mod Mod4

# Font for window titles and bar
font pango:JetBrains Mono 10

# No title bars, thin borders
default_border pixel 2
default_floating_border pixel 2

# Hide borders when only one window
hide_edge_borders smart

# Focus follows mouse (set to 'no' if you prefer click-to-focus)
focus_follows_mouse yes

#==============================================================================
# VIM-STYLE NAVIGATION (hjkl)
#==============================================================================

# Focus windows
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Move windows
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

#==============================================================================
# WORKSPACES
#==============================================================================

# Workspace names (customize as needed)
set $ws1 "1:term"
set $ws2 "2:web"
set $ws3 "3:code"
set $ws4 "4:chat"
set $ws5 "5:files"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9:music"
set $ws10 "10"

# Switch workspaces
bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10

# Move window to workspace
bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9
bindsym $mod+Shift+0 move container to workspace $ws10

# Quick workspace switching (back and forth)
bindsym $mod+Tab workspace back_and_forth
bindsym $mod+Shift+Tab move container to workspace back_and_forth

# Navigate workspaces (left/right)
bindsym $mod+bracketleft workspace prev
bindsym $mod+bracketright workspace next

#==============================================================================
# APPLICATIONS
#==============================================================================

# Terminal (Alacritty)
bindsym $mod+Return exec alacritty

# Application launcher (dmenu or rofi if installed)
bindsym $mod+space exec --no-startup-id rofi -show drun || dmenu_run
bindsym $mod+d exec --no-startup-id dmenu_run

# Browser
bindsym $mod+b exec firefox

# File manager
bindsym $mod+e exec nautilus || thunar || pcmanfm

#==============================================================================
# WINDOW MANAGEMENT
#==============================================================================

# Close window (single key - ergonomic)
bindsym $mod+q kill

# Toggle fullscreen
bindsym $mod+f fullscreen toggle

# Toggle floating
bindsym $mod+Shift+space floating toggle

# Toggle focus between tiling/floating
bindsym $mod+o focus mode_toggle

# Split orientation
bindsym $mod+backslash split h
bindsym $mod+minus split v
bindsym $mod+v split toggle

# Change layout
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+t layout toggle split

# Focus parent/child container
bindsym $mod+a focus parent
bindsym $mod+c focus child

# Scratchpad (dropdown terminal)
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+grave scratchpad show

# Drag floating windows with $mod+mouse
floating_modifier $mod

#==============================================================================
# RESIZE MODE
#==============================================================================

bindsym $mod+r mode "resize"

mode "resize" {
    # Vim-style resize
    bindsym h resize shrink width 10 px or 5 ppt
    bindsym j resize grow height 10 px or 5 ppt
    bindsym k resize shrink height 10 px or 5 ppt
    bindsym l resize grow width 10 px or 5 ppt

    # Arrow keys
    bindsym Left resize shrink width 10 px or 5 ppt
    bindsym Down resize grow height 10 px or 5 ppt
    bindsym Up resize shrink height 10 px or 5 ppt
    bindsym Right resize grow width 10 px or 5 ppt

    # Fine-grained resize with Shift
    bindsym Shift+h resize shrink width 2 px or 2 ppt
    bindsym Shift+j resize grow height 2 px or 2 ppt
    bindsym Shift+k resize shrink height 2 px or 2 ppt
    bindsym Shift+l resize grow width 2 px or 2 ppt

    # Exit resize mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}

#==============================================================================
# SYSTEM CONTROLS
#==============================================================================

# Lock screen
bindsym $mod+Escape exec i3lock -c 000000

# Power menu mode
bindsym $mod+Shift+e mode "exit: [l]ogout [r]eboot [s]hutdown"

mode "exit: [l]ogout [r]eboot [s]hutdown" {
    bindsym l exec i3-msg exit
    bindsym r exec systemctl reboot
    bindsym s exec systemctl poweroff
    bindsym Escape mode "default"
    bindsym Return mode "default"
}

# Reload/restart i3
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

#==============================================================================
# MEDIA & BRIGHTNESS KEYS
#==============================================================================

# Volume (requires pulseaudio/pipewire)
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle

# Brightness (requires brightnessctl or light)
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +5%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-

# Media controls
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous

#==============================================================================
# COLORS (Nord-inspired, easy on eyes)
#==============================================================================

# class                 border  bg      text    indicator child_border
client.focused          #5e81ac #5e81ac #eceff4 #88c0d0   #5e81ac
client.focused_inactive #4c566a #4c566a #eceff4 #4c566a   #4c566a
client.unfocused        #3b4252 #3b4252 #eceff4 #3b4252   #3b4252
client.urgent           #bf616a #bf616a #eceff4 #bf616a   #bf616a
client.placeholder      #2e3440 #2e3440 #eceff4 #2e3440   #2e3440
client.background       #2e3440

#==============================================================================
# STATUS BAR
#==============================================================================

bar {
    status_command i3status
    position top
    tray_output primary

    colors {
        background #2e3440
        statusline #eceff4
        separator  #4c566a

        # class            border  bg      text
        focused_workspace  #5e81ac #5e81ac #eceff4
        active_workspace   #4c566a #4c566a #eceff4
        inactive_workspace #3b4252 #3b4252 #eceff4
        urgent_workspace   #bf616a #bf616a #eceff4
    }
}

#==============================================================================
# STARTUP APPLICATIONS
#==============================================================================
#
# Disable disconnected HDMI output (prevents ghost display)
exec --no-startup-id xrandr --output HDMI-A-0 --off

# Set wallpaper (uncomment and set your path)
exec_always --no-startup-id feh --bg-scale "/home/sahaj/Downloads/vagabond_wallpaper.jpg"

# Compositor for transparency (optional)
exec --no-startup-id picom -b

# Network manager applet
exec --no-startup-id nm-applet

# Start on workspace 1
exec --no-startup-id i3-msg workspace $ws1
