{
  "env": {
    "CLAUDE_CODE_SCROLL_SPEED": "3"
  },
  "model": "sonnet",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/sahaj/.claude/hooks/mode-overlay.py",
            "timeout": 10,
            "statusMessage": "mode-overlay"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/sahaj/.claude/hooks/mode-overlay.py",
            "timeout": 10,
            "statusMessage": "mode-overlay compact-reset"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /home/sahaj/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "learning-opportunities@learning-opportunities": true,
    "orient@learning-opportunities": false
  },
  "extraKnownMarketplaces": {
    "learning-opportunities": {
      "source": {
        "source": "git",
        "url": "https://github.com/DrCatHicks/learning-opportunities.git"
      }
    }
  },
  "effortLevel": "xhigh",
  "advisorModel": "opus",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "editorMode": "vim"
}
